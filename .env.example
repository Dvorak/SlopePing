SKI_LOGIN_URL=https://allrounder-jobs.de/login
SKI_USERNAME=your_username
SKI_PASSWORD=your_password

# First version runs visibly for local debugging.
SKI_HEADLESS=false
SKI_SLOW_MO_MS=250
SKI_NAVIGATION_TIMEOUT_MS=30000

# Runtime data is kept outside the source tree. Individual paths may still be
# overridden when needed.
SLOPEPING_RUNTIME_DIR=var
SKI_STATE_PATH=var/state.json
SKI_SCREENSHOTS_DIR=var/screenshots
SKI_HEALTH_PATH=var/health.json
SKI_LOCK_PATH=var/slopeping.lock
SKI_ACTIONS_LOG_PATH=var/actions.log
SKI_CALENDAR_DIR=var/calendar_events
SKI_LOGS_DIR=var/logs
SKI_USED_NONCES_PATH=var/used-action-nonces.json
# A non-empty schedule must be followed by this many structurally valid empty
# results before the saved state may be cleared.
SKI_EMPTY_CONFIRMATION_RUNS=2
# Normal checks may retry transient browser/network failures. Explicit accept
# and decline actions are never retried automatically.
SKI_CHECK_RETRY_ATTEMPTS=2
SKI_CHECK_RETRY_DELAY_SECONDS=5
# Notify on the first failed run and again when this threshold is reached.
SKI_FAILURE_ALERT_THRESHOLD=2
# Retain diagnostic artifacts without allowing unbounded disk growth.
SKI_RETENTION_DAYS=30
SKI_SCREENSHOTS_MAX_FILES=200
SKI_CALENDAR_MAX_FILES=100
SKI_LOG_MAX_BYTES=5000000
SKI_LOG_BACKUPS=3

# Notification channel: ntfy or console.
NOTIFY_CHANNEL=ntfy
# Test mode: send a notification on every successful run with current lessons
# and new lessons. Set to false for normal "new lessons only" behavior.
NOTIFY_ALWAYS_SEND_REPORT=false

# ntfy notification settings. Use a long private topic.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=your-private-topic
NTFY_RETRY_ATTEMPTS=3
NTFY_RETRY_DELAY_SECONDS=2

# Override these when the live HTML differs.
SKI_USERNAME_LABEL=Benutzername
SKI_PASSWORD_LABEL=Passwort
SKI_LOGIN_BUTTON_NAME=Anmelden
SKI_MY_DATA_TEXT=Meine Daten
SKI_SCHEDULE_TEXT=Arbeitsplan/Verfügbarkeit
SKI_OVERVIEW_TEXT=Übersicht
SKI_OVERVIEW_TABLE_XPATH=xpath=following::table[1]

# Webhook configuration for remote action triggers (mobile notifications)
# Generate a strong random token and keep it secret
ACTION_WEBHOOK_TOKEN=your-secret-webhook-token
# Base URL where the webhook service is accessible (e.g., http://192.168.1.100:8000)
ACTION_WEBHOOK_BASE_URL=http://localhost:8000
# Safe default: local machine only. Use 0.0.0.0 only on trusted networks.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8000
# Notification links expire after 24 hours; final action confirmations expire
# after 10 minutes and cannot be submitted twice.
WEBHOOK_LINK_TTL_SECONDS=86400
WEBHOOK_ACTION_TTL_SECONDS=600
# Temporary migration switch only. Leave false so the long-term secret itself
# is rejected when used as a URL token.
WEBHOOK_ALLOW_LEGACY_TOKEN=false
